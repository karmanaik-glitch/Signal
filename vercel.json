{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "app",
  "buildCommand": null,
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options",    "value": "nosniff" },
      { "key": "X-Frame-Options",           "value": "DENY" },
      { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=(), payment=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
      {
        "key": "Content-Security-Policy",
        "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
      }
    ]},
    { "source": "/(snapshot|backtest).json",   "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/charts/:path*",              "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/sw.js",                      "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/icons/(.*)",                 "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/fonts/(.*)",                 "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
