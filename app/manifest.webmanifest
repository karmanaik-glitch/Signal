{
  "name": "Signal Markets Terminal",
  "short_name": "Signal",
  "description": "Rules-based Indian equity research terminal with a paper-traded model portfolio. End-of-day, free, no broker.",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "icons/icon-192.png",         "sizes": "192x192",   "type": "image/png" },
    { "src": "icons/icon-512.png",         "sizes": "512x512",   "type": "image/png" },
    { "src": "icons/icon-maskable-512.png","sizes": "512x512",   "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg",             "sizes": "any",       "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Signals",  "url": "./#/signals",  "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Watchlist","url": "./#/watchlist","icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Rulebot", "url": "./#/rulebot",  "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
